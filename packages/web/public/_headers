# Cloudflare Pages headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The scanner renders fetched HTML in a same-origin frame, so it needs
# frame-src 'self' and inline styles from the scanned page. It never needs to
# execute anything from another origin: script-src stays 'self' only.
/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data: blob:; font-src * data:; connect-src *; frame-src 'self' blob:; base-uri 'none'; form-action 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/audit.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/sitemap.xml
  Cache-Control: public, max-age=86400
